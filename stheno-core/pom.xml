<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.b077as</groupId>
    <artifactId>stheno-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>stheno-core</artifactId>
  <name>Stheno Core</name>
  <description>Spring-free core: Peppol identifier checks, SBDH reading and building, inbound processing with duplicate detection, and
    the acknowledgement client for the application's own Access Point.</description>

  <dependencies>
    <!-- Identifiers, code list states and participant id value checks -->
    <dependency>
      <groupId>com.helger.peppol</groupId>
      <artifactId>peppol-id</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.peppol</groupId>
      <artifactId>peppol-id-checks</artifactId>
    </dependency>
    <!-- Reading and writing the Peppol Business Message Envelope (SBDH) -->
    <dependency>
      <groupId>com.helger.peppol</groupId>
      <artifactId>peppol-sbdh</artifactId>
    </dependency>

    <!-- Reading received Message Level Status documents -->
    <dependency>
      <groupId>com.helger.peppol</groupId>
      <artifactId>peppol-mls</artifactId>
    </dependency>
    <!-- OPTIONAL features: the application adds these dependencies to switch the feature on (see README) -->
    <!-- "Can X receive Y?" lookups (SMP via SML/DNS) -->
    <dependency>
      <groupId>com.helger.peppol</groupId>
      <artifactId>peppol-smp-client</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Document validation with the official rule sets; ddd picks the rule set for a document -->
    <dependency>
      <groupId>com.helger.phive</groupId>
      <artifactId>phive-xml</artifactId>
      <version>${phive.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.helger.phive.rules</groupId>
      <artifactId>phive-rules-peppol</artifactId>
      <version>${phive-rules.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.helger</groupId>
      <artifactId>ddd</artifactId>
      <version>${ddd.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Bean Validation annotations for identifiers -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <version>3.1.1</version>
      <optional>true</optional>
    </dependency>

    <!-- JAXB implementation for the envelope and MLS (un)marshalling -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.9</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.peppol</groupId>
      <artifactId>peppol-testfiles</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>9.0.1.Final</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.4.240</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>6.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
